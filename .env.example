# ── AI Providers (Multi-Key Sticky Failover Supported via Comma-Separated Keys) ──
AI_PROVIDER=gemini
GEMINI_API_KEY=your_primary_gemini_key,your_backup_gemini_key
GROQ_API_KEY=your_primary_groq_key,your_backup_groq_key

# ── Telegram Notifications (Optional) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── PostgreSQL 16 (docker-compose maps host 5433 -> container 5432) ─────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=jobhunter

# ── Redis 7 Streams ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Runtime ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENVIRONMENT=development
